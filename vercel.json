{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/hossain", "destination": "/index.html" },
    { "source": "/hossain/:path*", "destination": "/index.html" },
    { "source": "/product/:path*", "destination": "/index.html" },
    { "source": "/category/:path*", "destination": "/index.html" },
    { "source": "/((?!api/.*|assets/.*).*)", "destination": "/index.html" }
  ]
}
