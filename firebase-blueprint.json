        "channelUrl": { "type": "string", "maxLength": 240 },
        "bkashNumber": { "type": "string", "maxLength": 32 },
        "nagadNumber": { "type": "string", "maxLength": 32 },
        "bankDetails": { "type": "string", "maxLength": 300 },
        "affiliateCode": { "type": "string", "maxLength": 40 },
        "commissionPercent": { "type": "number" },
        "clicksCount": { "type": "number" },
        "totalOrders": { "type": "number" },
        "walletBalance": { "type": "number" },
        "totalEarnings": { "type": "number" },
        "status": { "type": "string", "enum": ["pending", "approved", "suspended"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "phone", "affiliateCode", "status", "createdAt"]
    },
    "AffiliateConversionRecord": {
      "title": "AffiliateConversionRecord",
      "description": "Referral order conversion attributed to an affiliate link.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 80 },
        "affiliateId": { "type": "string", "maxLength": 80 },
        "affiliateCode": { "type": "string", "maxLength": 40 },
        "orderId": { "type": "string", "maxLength": 80 },
        "customerName": { "type": "string", "maxLength": 120 },
        "orderTotal": { "type": "number" },
        "commissionPercent": { "type": "number" },
        "commissionAmount": { "type": "number" },
        "status": { "type": "string", "enum": ["pending", "credited", "cancelled"] },
        "submittedAt": { "type": "string", "maxLength": 64 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "affiliateId", "affiliateCode", "orderId", "orderTotal", "commissionAmount", "status", "createdAt"]
    },
    "AffiliatePayoutRecord": {
      "title": "AffiliatePayoutRecord",
      "description": "Affiliate commission payout withdrawal request.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 80 },
        "affiliateId": { "type": "string", "maxLength": 80 },
        "affiliateName": { "type": "string", "maxLength": 120 },
        "affiliatePhone": { "type": "string", "maxLength": 32 },
        "method": { "type": "string", "enum": ["bkash", "nagad", "rocket", "bank"] },
        "accountNumber": { "type": "string", "maxLength": 160 },
        "amount": { "type": "number" },
        "status": { "type": "string", "enum": ["pending", "paid", "rejected"] },
        "trxId": { "type": "string", "maxLength": 80 },
        "note": { "type": "string", "maxLength": 300 },
        "submittedAt": { "type": "string", "maxLength": 64 },
        "processedAt": { "type": "string", "maxLength": 64 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "affiliateId", "affiliateName", "method", "accountNumber", "amount", "status", "createdAt"]
    }
  },
