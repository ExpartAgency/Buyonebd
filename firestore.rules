rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (request.auth.token.email == 'buyonebd@gmail.com' && request.auth.token.email_verified == true)
      );
    }

    function isValidStorefrontSettings(data) {
      return data.keys().hasAll(['storeName', 'theme', 'updatedAt'])
        && data.keys().hasOnly([
          'storeName', 'storeNameBn', 'logoUrl', 'logoMode', 'tagline', 'taglineBn',
          'hotline', 'whatsappNumber', 'supportEmail', 'address', 'deliveryFees',
          'paymentSettings', 'aiCallSettings', 'announcementBar', 'theme', 'themeColors',
          'cmsTexts', 'spinSettings', 'whatsappTemplates', 'marketingSettings',
          'aiSettings', 'courierSettings', 'smtpSettings', 'seoSettings', 'flashSale',
          'footerSettings', 'singleProductCms', 'organicMarketing', 'walletSettings',
          'promoCoupons', 'brandAttributes', 'updatedAt'
        ])
        && data.storeName is string && data.storeName.size() >= 1 && data.storeName.size() <= 120
        && data.theme is string && data.theme.size() >= 1 && data.theme.size() <= 40
        && data.updatedAt is timestamp;
    }

    function isValidCatalogProduct(data) {
      return data.keys().hasAll(['id', 'title', 'price', 'stock', 'updatedAt'])
        && data.keys().hasOnly([
          'id', 'title', 'titleBn', 'description', 'descriptionBn', 'price', 'originalPrice',
          'stock', 'category', 'categoryBn', 'subcategory', 'tags', 'images', 'sku',
          'barcode', 'freeShipping', 'customDeliveryFees', 'rating', 'reviewsCount',
          'soldCount', 'loyaltyPoints', 'isFlashSale', 'colors', 'sizes', 'features',
          'featuresBn', 'videoUrl', 'warrantyInfo', 'warrantyInfoBn', 'seo', 'updatedAt'
        ])
        && isValidId(data.id)
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 200
        && data.price is number && data.price >= 0
        && data.stock is number && data.stock >= 0
        && data.updatedAt is timestamp;
    }

    function isValidOrderPayload(data) {
      return data.keys().hasAll([
          'id', 'customer', 'items', 'pricing', 'payment', 'deliveryZone', 'status', 'createdAt', 'serverCreatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'customer', 'items', 'pricing', 'payment', 'deliveryZone', 'status',
          'aiCallStatus', 'courier', 'fraudCheck', 'source', 'createdAt', 'serverCreatedAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && data.customer is map
        && data.customer.keys().hasAll(['name', 'phone', 'address', 'district'])
        && data.customer.name is string && data.customer.name.size() >= 1 && data.customer.name.size() <= 120
        && data.customer.phone is string && data.customer.phone.size() >= 6 && data.customer.phone.size() <= 32
        && data.customer.address is string && data.customer.address.size() >= 1 && data.customer.address.size() <= 400
        && data.customer.district is string && data.customer.district.size() >= 1 && data.customer.district.size() <= 120
        && data.items is list && data.items.size() >= 1 && data.items.size() <= 50 && data.items[0] is map
        && data.pricing is map && data.pricing.total is number && data.pricing.total >= 0
        && data.payment is map && data.payment.method is string && data.payment.method.size() <= 30
        && data.deliveryZone in ['dhaka_inside', 'dhaka_sub', 'dhaka_outside']
        && data.status in ['pending', 'ai_confirmed', 'processing', 'on_hold', 'shipped', 'delivered', 'partial', 'cancelled']
        && data.createdAt is string && data.createdAt.size() <= 64
        && data.serverCreatedAt is timestamp;
    }

    function isValidAdminUser(data) {
      return data.keys().hasAll(['uid', 'email', 'createdAt'])
        && data.keys().hasOnly(['uid', 'email', 'createdAt'])
        && data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 160
        && data.createdAt is timestamp;
    }

    match /storefront/{configId} {
      allow get: if isValidId(configId);
      allow list: if true;
      allow create: if isAdmin() && isValidId(configId) && isValidStorefrontSettings(incoming())
        && incoming().updatedAt == request.time;
      allow update: if isAdmin() && isValidId(configId) && isValidStorefrontSettings(incoming())
        && incoming().updatedAt == request.time;
      allow delete: if false;
    }

    match /products/{productId} {
      allow get: if isValidId(productId);
      allow list: if true;
      allow create: if isAdmin() && isValidId(productId) && isValidCatalogProduct(incoming())
        && incoming().id == productId
        && incoming().updatedAt == request.time;
      allow update: if isAdmin() && isValidId(productId) && isValidCatalogProduct(incoming())
        && incoming().id == existing().id
        && incoming().updatedAt == request.time;
      allow delete: if isAdmin() && isValidId(productId);
    }

    match /orders/{orderId} {
      allow get: if isAdmin() && isValidId(orderId);
      allow list: if isAdmin();
      allow create: if isValidId(orderId)
        && isValidOrderPayload(incoming())
        && incoming().id == orderId
        && (incoming().status in ['pending', 'partial'] || isAdmin())
        && incoming().serverCreatedAt == request.time;
      allow update: if isAdmin()
        && isValidId(orderId)
        && isValidOrderPayload(incoming())
        && incoming().id == existing().id
        && incoming().createdAt == existing().createdAt
        && incoming().serverCreatedAt == existing().serverCreatedAt
        && incoming().updatedAt == request.time
        && (
          existing().status != 'cancelled' ||
          incoming().diff(existing()).affectedKeys().hasOnly(['status', 'courier', 'fraudCheck', 'updatedAt'])
        );
      allow delete: if isAdmin() && isValidId(orderId);
    }

    match /admins/{uid} {
      allow get: if isAdmin() && isValidId(uid);
      allow list: if isAdmin();
      allow create: if isAdmin() && isValidId(uid) && isValidAdminUser(incoming())
        && incoming().uid == uid
        && incoming().createdAt == request.time;
      allow update: if false;
      allow delete: if isAdmin() && isValidId(uid);
    }
  }
}
