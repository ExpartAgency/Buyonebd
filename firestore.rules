rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (request.auth.token.email == 'buyonebd@gmail.com' && request.auth.token.email_verified == true)
      );
    }

    function isValidStorefrontSettings(data) {
      return data.keys().hasAll(['storeName', 'theme', 'updatedAt'])
        && data.keys().hasOnly([
          'storeName', 'storeNameBn', 'logoUrl', 'faviconUrl', 'logoMode', 'tagline', 'taglineBn',
          'hotline', 'whatsappNumber', 'supportEmail', 'address', 'deliveryFees',
          'paymentSettings', 'aiCallSettings', 'announcementBar', 'theme', 'themeColors',
          'cmsTexts', 'spinSettings', 'whatsappTemplates', 'marketingTemplates',
          'aiSettings', 'seoSettings', 'flashSale', 'footerSettings', 'singleProductCms',
          'organicMarketing', 'walletSettings', 'promoCoupons', 'deliveryBoys', 'brandAttributes',
          'loyaltySettings', 'resellerSettings', 'wholesaleSettings', 'globalMarketingSettings',
          'aiAutopilotSettings', 'invoiceSettings', 'categories', 'sliders', 'updatedAt'
        ])
        && data.storeName is string && data.storeName.size() >= 1 && data.storeName.size() <= 120
        && data.theme is string && data.theme.size() >= 1 && data.theme.size() <= 40
        && (!data.keys().hasAny(['categories']) || (data.categories is list && data.categories.size() <= 60))
        && (!data.keys().hasAny(['sliders']) || (data.sliders is list && data.sliders.size() <= 30))
        && (!data.keys().hasAny(['promoCoupons']) || (data.promoCoupons is list && data.promoCoupons.size() <= 100))
        && (!data.keys().hasAny(['deliveryBoys']) || (data.deliveryBoys is list && data.deliveryBoys.size() <= 100))
        && data.updatedAt is timestamp;
    }

    function isValidAdminPrivateConfig(data) {
      return data.keys().hasAll(['updatedAt'])
        && data.keys().hasOnly([
          'smtpSettings', 'courierSettings', 'marketingSettings', 'aiSettings',
          'aiKeywordRules', 'hostingerDbSettings', 'securitySettings',
          'updatedByEmail', 'updatedAt'
        ])
        && (!data.keys().hasAny(['smtpSettings']) || data.smtpSettings is map)
        && (!data.keys().hasAny(['courierSettings']) || data.courierSettings is map)
        && (!data.keys().hasAny(['marketingSettings']) || data.marketingSettings is map)
        && (!data.keys().hasAny(['aiSettings']) || data.aiSettings is map)
        && (!data.keys().hasAny(['hostingerDbSettings']) || data.hostingerDbSettings is map)
        && (!data.keys().hasAny(['securitySettings']) || data.securitySettings is map)
        && (!data.keys().hasAny(['aiKeywordRules']) || (data.aiKeywordRules is list && data.aiKeywordRules.size() <= 100))
        && (!data.keys().hasAny(['updatedByEmail']) || (data.updatedByEmail is string && data.updatedByEmail.size() <= 160))
        && data.updatedAt is timestamp;
    }

    function isValidCatalogProduct(data) {
      return data.keys().hasAll(['id', 'title', 'price', 'stock', 'updatedAt'])
        && data.keys().hasOnly([
          'id', 'title', 'titleBn', 'description', 'descriptionBn', 'brand', 'brandBn', 'price', 'originalPrice',
          'stock', 'category', 'categoryBn', 'subcategory', 'tags', 'images', 'sku',
          'barcode', 'freeShipping', 'customDeliveryFees', 'rating', 'reviewsCount',
          'soldCount', 'loyaltyPoints', 'isFlashSale', 'colors', 'sizes', 'attributes', 'features',
          'featuresBn', 'videoUrl', 'warrantyInfo', 'warrantyInfoBn', 'seo',
          'resellable', 'resellerPrice', 'wholesaleEnabled', 'wholesalePrice', 'wholesaleMinQty', 'wholesaleTiers',
          'updatedAt'
        ])
        && isValidId(data.id)
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 200
        && data.price is number && data.price >= 0
        && data.stock is number && data.stock >= 0
        && (!data.keys().hasAny(['brand']) || (data.brand is string && data.brand.size() <= 120))
        && (!data.keys().hasAny(['brandBn']) || (data.brandBn is string && data.brandBn.size() <= 140))
        && (!data.keys().hasAny(['attributes']) || (data.attributes is list && data.attributes.size() <= 15))
        && (!data.keys().hasAny(['images']) || (data.images is list && data.images.size() <= 12))
        && data.updatedAt is timestamp;
    }

    function isValidOrderPayload(data) {
      return data.keys().hasAll([
          'id', 'customer', 'items', 'pricing', 'payment', 'deliveryZone', 'status', 'createdAt', 'serverCreatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'customer', 'items', 'pricing', 'payment', 'deliveryZone', 'status',
          'aiCallStatus', 'courier', 'fraudCheck', 'source',
          'partnerType', 'resellerId', 'resellerName', 'resellerCode', 'resellerProfit', 'customerQuotedPrice',
          'wholesaleBuyerId', 'wholesaleCompany',
          'createdAt', 'serverCreatedAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && data.customer is map
        && data.customer.keys().hasAll(['name', 'phone', 'address', 'district'])
        && data.customer.name is string && data.customer.name.size() >= 1 && data.customer.name.size() <= 120
        && data.customer.phone is string && data.customer.phone.size() >= 6 && data.customer.phone.size() <= 32
        && data.customer.address is string && data.customer.address.size() >= 1 && data.customer.address.size() <= 400
        && data.customer.district is string && data.customer.district.size() >= 1 && data.customer.district.size() <= 120
        && data.items is list && data.items.size() >= 1 && data.items.size() <= 50 && data.items[0] is map
        && data.pricing is map && data.pricing.total is number && data.pricing.total >= 0
        && data.payment is map && data.payment.method is string && data.payment.method.size() <= 30
        && data.deliveryZone in ['dhaka_inside', 'dhaka_sub', 'dhaka_outside']
        && data.status in ['pending', 'ai_confirmed', 'processing', 'on_hold', 'shipped', 'delivered', 'partial', 'cancelled']
        && data.createdAt is string && data.createdAt.size() <= 64
        && data.serverCreatedAt is timestamp;
    }

    function isValidReviewPayload(data) {
      return data.keys().hasAll(['id', 'productId', 'customerName', 'rating', 'comment', 'isApproved', 'createdAt'])
        && data.keys().hasOnly([
          'id', 'productId', 'customerName', 'rating', 'comment', 'date', 'verifiedPurchase', 'isApproved', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && data.productId is string && data.productId.size() >= 1 && data.productId.size() <= 80
        && data.customerName is string && data.customerName.size() >= 1 && data.customerName.size() <= 120
        && data.rating is number && data.rating >= 1 && data.rating <= 5
        && data.comment is string && data.comment.size() >= 1 && data.comment.size() <= 1500
        && data.isApproved is bool
        && data.createdAt is timestamp;
    }

    function isValidMediaAsset(data) {
      return data.keys().hasAll(['id', 'name', 'url', 'updatedAt'])
        && data.keys().hasOnly([
          'id', 'name', 'url', 'source', 'width', 'height', 'sizeKb', 'mimeType', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 160
        && data.url is string && data.url.size() >= 1 && data.url.size() <= 250000
        && data.updatedAt is timestamp;
    }

    function isValidCustomerAccount(data) {
      return data.keys().hasAll(['id', 'name', 'phone', 'walletBalance', 'loyaltyPoints', 'updatedAt'])
        && data.keys().hasOnly([
          'id', 'name', 'username', 'phone', 'email', 'address', 'district',
          'loyaltyPoints', 'walletBalance', 'lastPurchaseAt', 'lastWalletCreditAt',
          'browsingHistory', 'savedCoupons', 'loyaltyHistory', 'updatedAt'
        ])
        && isValidId(data.id)
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 120
        && data.phone is string && data.phone.size() >= 6 && data.phone.size() <= 32
        && data.walletBalance is number && data.walletBalance >= 0
        && data.loyaltyPoints is number && data.loyaltyPoints >= 0
        && (!data.keys().hasAny(['email']) || (data.email is string && data.email.size() <= 160))
        && (!data.keys().hasAny(['address']) || (data.address is string && data.address.size() <= 400))
        && (!data.keys().hasAny(['browsingHistory']) || (data.browsingHistory is list && data.browsingHistory.size() <= 20))
        && (!data.keys().hasAny(['savedCoupons']) || (data.savedCoupons is list && data.savedCoupons.size() <= 30))
        && (!data.keys().hasAny(['loyaltyHistory']) || (data.loyaltyHistory is list && data.loyaltyHistory.size() <= 50))
        && data.updatedAt is timestamp;
    }

    function isValidWalletTopUp(data) {
      return data.keys().hasAll(['id', 'customerName', 'customerPhone', 'method', 'amount', 'senderNumber', 'trxId', 'status', 'createdAt'])
        && data.keys().hasOnly([
          'id', 'customerName', 'customerPhone', 'method', 'amount', 'senderNumber',
          'trxId', 'status', 'submittedAt', 'reviewedAt', 'note', 'activityLog', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && data.customerName is string && data.customerName.size() >= 1 && data.customerName.size() <= 120
        && data.customerPhone is string && data.customerPhone.size() >= 6 && data.customerPhone.size() <= 32
        && data.method in ['bkash', 'nagad', 'rocket', 'upay']
        && data.amount is number && data.amount > 0 && data.amount <= 500000
        && data.senderNumber is string && data.senderNumber.size() >= 6 && data.senderNumber.size() <= 32
        && data.trxId is string && data.trxId.size() >= 2 && data.trxId.size() <= 80
        && data.status in ['pending', 'approved', 'rejected']
        && (!data.keys().hasAny(['activityLog']) || (data.activityLog is list && data.activityLog.size() <= 50))
        && data.createdAt is timestamp;
    }

    function isValidAbandonedCart(data) {
      return data.keys().hasAll(['id', 'customerPhone', 'items', 'totalValue', 'whatsappSent', 'recovered', 'createdAt'])
        && data.keys().hasOnly([
          'id', 'customerName', 'customerPhone', 'customerAddress', 'customerDistrict', 'items', 'totalValue', 'abandonedAt',
          'whatsappSent', 'recovered', 'recoveredAt', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && data.customerPhone is string && data.customerPhone.size() >= 6 && data.customerPhone.size() <= 32
        && data.items is list && data.items.size() >= 1 && data.items.size() <= 40
        && data.totalValue is number && data.totalValue >= 0
        && data.whatsappSent is bool
        && data.recovered is bool
        && data.createdAt is timestamp;
    }

    function isValidPriceAlert(data) {
      return data.keys().hasAll(['id', 'productId', 'contact', 'targetPrice', 'createdAt'])
        && data.keys().hasOnly(['id', 'productId', 'productTitle', 'productTitleBn', 'currentPrice', 'contact', 'targetPrice', 'dateLabel', 'status', 'createdAt'])
        && isValidId(data.id)
        && data.productId is string && data.productId.size() >= 1 && data.productId.size() <= 80
        && data.contact is string && data.contact.size() >= 3 && data.contact.size() <= 160
        && data.targetPrice is number && data.targetPrice > 0
        && data.createdAt is timestamp;
    }

    function isValidWaitlistEntry(data) {
      return data.keys().hasAll(['id', 'productId', 'contact', 'contactType', 'status', 'createdAt'])
        && data.keys().hasOnly(['id', 'productId', 'productTitle', 'productTitleBn', 'contact', 'contactType', 'status', 'createdAt'])
        && isValidId(data.id)
        && data.productId is string && data.productId.size() >= 1 && data.productId.size() <= 80
        && (!data.keys().hasAny(['productTitle']) || (data.productTitle is string && data.productTitle.size() <= 200))
        && (!data.keys().hasAny(['productTitleBn']) || (data.productTitleBn is string && data.productTitleBn.size() <= 240))
        && data.contact is string && data.contact.size() >= 5 && data.contact.size() <= 160
        && data.contactType in ['email', 'phone']
        && data.status in ['waiting', 'notified']
        && data.createdAt is timestamp;
    }

    function isValidStaffUser(data) {
      return data.keys().hasAll(['id', 'name', 'email', 'role', 'status', 'updatedAt'])
        && data.keys().hasOnly(['id', 'name', 'email', 'phone', 'role', 'status', 'createdAtLabel', 'updatedAt'])
        && isValidId(data.id)
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 120
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 160
        && data.role in ['super_admin', 'order_manager', 'support_agent', 'customer', 'admin', 'manager', 'support']
        && data.status in ['active', 'inactive']
        && data.updatedAt is timestamp;
    }

    function isValidAdminUser(data) {
      return data.keys().hasAll(['uid', 'email', 'createdAt'])
        && data.keys().hasOnly(['uid', 'email', 'createdAt'])
        && data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 160
        && data.createdAt is timestamp;
    }

    function isValidResellerAccount(data) {
      return data.keys().hasAll(['id', 'name', 'phone', 'resellerCode', 'status', 'createdAt'])
        && data.keys().hasOnly([
          'id', 'name', 'phone', 'email', 'district', 'address', 'fbPageUrl',
          'bkashNumber', 'nagadNumber', 'bankDetails', 'resellerCode',
          'commissionPercent', 'walletBalance', 'totalEarnings', 'totalOrders',
          'status', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 120
        && data.phone is string && data.phone.size() >= 6 && data.phone.size() <= 32
        && data.resellerCode is string && data.resellerCode.size() >= 2 && data.resellerCode.size() <= 40
        && data.status in ['pending', 'approved', 'suspended']
        && data.createdAt is timestamp;
    }

    function isValidResellerPayout(data) {
      return data.keys().hasAll(['id', 'resellerId', 'resellerName', 'method', 'accountNumber', 'amount', 'status', 'createdAt'])
        && data.keys().hasOnly([
          'id', 'resellerId', 'resellerName', 'resellerPhone', 'method', 'accountNumber',
          'amount', 'status', 'trxId', 'note', 'submittedAt', 'processedAt', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && data.resellerId is string && data.resellerId.size() >= 1 && data.resellerId.size() <= 80
        && data.method in ['bkash', 'nagad', 'rocket', 'bank']
        && data.amount is number && data.amount > 0 && data.amount <= 500000
        && data.status in ['pending', 'paid', 'rejected']
        && data.createdAt is timestamp;
    }

    function isValidWholesaleAccount(data) {
      return data.keys().hasAll(['id', 'contactName', 'companyName', 'phone', 'tier', 'status', 'createdAt'])
        && data.keys().hasOnly([
          'id', 'contactName', 'companyName', 'phone', 'email', 'tradeLicenseNo', 'nidNumber',
          'district', 'address', 'businessType', 'monthlyVolumeEstimate', 'tier',
          'extraDiscountPercent', 'creditLimitBdt', 'status', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && data.contactName is string && data.contactName.size() >= 1 && data.contactName.size() <= 120
        && data.companyName is string && data.companyName.size() >= 1 && data.companyName.size() <= 160
        && data.phone is string && data.phone.size() >= 6 && data.phone.size() <= 32
        && data.tier in ['Silver', 'Gold', 'Platinum']
        && data.status in ['pending', 'approved', 'suspended']
        && data.createdAt is timestamp;
    }

    function isValidWholesaleQuote(data) {
      return data.keys().hasAll(['id', 'wholesalerId', 'companyName', 'productTitle', 'requestedQty', 'status', 'createdAt'])
        && data.keys().hasOnly([
          'id', 'wholesalerId', 'companyName', 'phone', 'productId', 'productTitle',
          'requestedQty', 'targetUnitPrice', 'adminQuotedPrice', 'notes', 'status',
          'submittedAt', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && data.wholesalerId is string && data.wholesalerId.size() >= 1 && data.wholesalerId.size() <= 80
        && data.requestedQty is number && data.requestedQty >= 1
        && data.status in ['pending', 'quoted', 'accepted', 'rejected']
        && data.createdAt is timestamp;
    }

    match /storefront/{configId} {
      allow get: if isValidId(configId);
      allow list: if true;
      allow create: if isAdmin() && isValidId(configId) && isValidStorefrontSettings(incoming())
        && incoming().updatedAt == request.time;
      allow update: if isAdmin() && isValidId(configId) && isValidStorefrontSettings(incoming())
        && incoming().updatedAt == request.time;
      allow delete: if false;
    }

    match /admin_config/{configId} {
      allow get: if isAdmin() && isValidId(configId);
      allow list: if isAdmin();
      allow create: if isAdmin() && isValidId(configId) && isValidAdminPrivateConfig(incoming())
        && incoming().updatedAt == request.time;
      allow update: if isAdmin() && isValidId(configId) && isValidAdminPrivateConfig(incoming())
        && incoming().updatedAt == request.time;
      allow delete: if isAdmin() && isValidId(configId);
    }


    match /products/{productId} {
      allow get: if isValidId(productId);
      allow list: if true;
      allow create: if isAdmin() && isValidId(productId) && isValidCatalogProduct(incoming())
        && incoming().id == productId
        && incoming().updatedAt == request.time;
      allow update: if isAdmin() && isValidId(productId) && isValidCatalogProduct(incoming())
        && incoming().id == existing().id
        && incoming().updatedAt == request.time;
      allow delete: if isAdmin() && isValidId(productId);
    }

    match /orders/{orderId} {
      allow get: if isAdmin() && isValidId(orderId);
      allow list: if isAdmin();
      allow create: if isValidId(orderId)
        && isValidOrderPayload(incoming())
        && incoming().id == orderId
        && (incoming().status in ['pending', 'partial'] || isAdmin())
        && incoming().serverCreatedAt == request.time;
      allow update: if isValidId(orderId)
        && isValidOrderPayload(incoming())
        && incoming().id == existing().id
        && incoming().createdAt == existing().createdAt
        && incoming().serverCreatedAt == existing().serverCreatedAt
        && incoming().updatedAt == request.time
        && (
          (
            isAdmin()
            && (
              existing().status != 'cancelled' ||
              incoming().diff(existing()).affectedKeys().hasOnly(['status', 'courier', 'fraudCheck', 'updatedAt'])
            )
          ) || (
            existing().status in ['pending', 'on_hold']
            && incoming().status == 'ai_confirmed'
            && incoming().aiCallStatus is map
            && incoming().aiCallStatus.confirmedByCustomer == true
            && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'aiCallStatus', 'courier', 'updatedAt'])
          )
        );
      allow delete: if isAdmin() && isValidId(orderId);
    }

    match /reviews/{reviewId} {
      allow get: if isValidId(reviewId);
      allow list: if resource.data.isApproved == true || isAdmin();
      allow create: if isValidId(reviewId)
        && isValidReviewPayload(incoming())
        && incoming().id == reviewId
        && incoming().createdAt == request.time;
      allow update: if isAdmin()
        && isValidId(reviewId)
        && isValidReviewPayload(incoming())
        && incoming().id == existing().id
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time;
      allow delete: if isAdmin() && isValidId(reviewId);
    }

    match /media_library/{mediaId} {
      allow get: if isValidId(mediaId);
      allow list: if true;
      allow create: if isAdmin() && isValidId(mediaId) && isValidMediaAsset(incoming())
        && incoming().id == mediaId
        && incoming().updatedAt == request.time;
      allow update: if isAdmin() && isValidId(mediaId) && isValidMediaAsset(incoming())
        && incoming().id == existing().id
        && incoming().updatedAt == request.time;
      allow delete: if isAdmin() && isValidId(mediaId);
    }

    match /customers/{customerId} {
      allow get: if isAdmin() && isValidId(customerId);
      allow list: if isAdmin();
      allow create: if isAdmin() && isValidId(customerId) && isValidCustomerAccount(incoming())
        && incoming().id == customerId
        && incoming().updatedAt == request.time;
      allow update: if isAdmin() && isValidId(customerId) && isValidCustomerAccount(incoming())
        && incoming().id == existing().id
        && incoming().updatedAt == request.time;
      allow delete: if isAdmin() && isValidId(customerId);
    }

    match /wallet_topups/{topupId} {
      allow get: if isAdmin() && isValidId(topupId);
      allow list: if isAdmin();
      allow create: if isValidId(topupId)
        && isValidWalletTopUp(incoming())
        && incoming().id == topupId
        && (incoming().status == 'pending' || isAdmin())
        && incoming().createdAt == request.time;
      allow update: if isAdmin()
        && isValidId(topupId)
        && isValidWalletTopUp(incoming())
        && incoming().id == existing().id
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time;
      allow delete: if isAdmin() && isValidId(topupId);
    }

    match /abandoned_carts/{cartId} {
      allow get: if isAdmin() && isValidId(cartId);
      allow list: if isAdmin();
      allow create: if isValidId(cartId)
        && isValidAbandonedCart(incoming())
        && incoming().id == cartId
        && incoming().createdAt == request.time;
      allow update: if isAdmin()
        && isValidId(cartId)
        && isValidAbandonedCart(incoming())
        && incoming().id == existing().id
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time;
      allow delete: if isAdmin() && isValidId(cartId);
    }

    match /price_alerts/{alertId} {
      allow get: if isAdmin() && isValidId(alertId);
      allow list: if isAdmin();
      allow create: if isValidId(alertId)
        && isValidPriceAlert(incoming())
        && incoming().id == alertId
        && incoming().createdAt == request.time;
      allow update: if isAdmin()
        && isValidId(alertId)
        && isValidPriceAlert(incoming())
        && incoming().id == existing().id
        && incoming().createdAt == existing().createdAt;
      allow delete: if isAdmin() && isValidId(alertId);
    }

    match /Waitlist/{waitlistId} {
      allow get: if isAdmin() && isValidId(waitlistId);
      allow list: if isAdmin();
      allow create: if isValidId(waitlistId)
        && isValidWaitlistEntry(incoming())
        && incoming().id == waitlistId
        && incoming().status == 'waiting'
        && incoming().createdAt == request.time;
      allow update: if isAdmin()
        && isValidId(waitlistId)
        && isValidWaitlistEntry(incoming())
        && incoming().id == existing().id
        && incoming().createdAt == existing().createdAt;
      allow delete: if isAdmin() && isValidId(waitlistId);
    }

    match /staff_users/{userId} {
      allow get: if isAdmin() && isValidId(userId);
      allow list: if isAdmin();
      allow create: if isAdmin() && isValidId(userId) && isValidStaffUser(incoming())
        && incoming().id == userId
        && incoming().updatedAt == request.time;
      allow update: if isAdmin() && isValidId(userId) && isValidStaffUser(incoming())
        && incoming().id == existing().id
        && incoming().updatedAt == request.time;
      allow delete: if isAdmin() && isValidId(userId);
    }

    match /admins/{uid} {
      allow get: if isAdmin() && isValidId(uid);
      allow list: if isAdmin();
      allow create: if isAdmin() && isValidId(uid) && isValidAdminUser(incoming())
        && incoming().uid == uid
        && incoming().createdAt == request.time;
      allow update: if false;
      allow delete: if isAdmin() && isValidId(uid);
    }

    match /resellers/{resellerId} {
      allow get: if isAdmin() && isValidId(resellerId);
      allow list: if isAdmin();
      allow create: if isValidId(resellerId)
        && isValidResellerAccount(incoming())
        && incoming().id == resellerId
        && (incoming().status == 'pending' || isAdmin())
        && incoming().createdAt == request.time;
      allow update: if isAdmin() && isValidId(resellerId)
        && isValidResellerAccount(incoming())
        && incoming().id == existing().id
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time;
      allow delete: if isAdmin() && isValidId(resellerId);
    }

    match /reseller_payouts/{payoutId} {
      allow get: if isAdmin() && isValidId(payoutId);
      allow list: if isAdmin();
      allow create: if isValidId(payoutId)
        && isValidResellerPayout(incoming())
        && incoming().id == payoutId
        && (incoming().status == 'pending' || isAdmin())
        && incoming().createdAt == request.time;
      allow update: if isAdmin() && isValidId(payoutId)
        && isValidResellerPayout(incoming())
        && incoming().id == existing().id
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time;
      allow delete: if isAdmin() && isValidId(payoutId);
    }

    match /wholesalers/{wholesalerId} {
      allow get: if isAdmin() && isValidId(wholesalerId);
      allow list: if isAdmin();
      allow create: if isValidId(wholesalerId)
        && isValidWholesaleAccount(incoming())
        && incoming().id == wholesalerId
        && (incoming().status == 'pending' || isAdmin())
        && incoming().createdAt == request.time;
      allow update: if isAdmin() && isValidId(wholesalerId)
        && isValidWholesaleAccount(incoming())
        && incoming().id == existing().id
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time;
      allow delete: if isAdmin() && isValidId(wholesalerId);
    }

    match /wholesale_quotes/{quoteId} {
      allow get: if isAdmin() && isValidId(quoteId);
      allow list: if isAdmin();
      allow create: if isValidId(quoteId)
        && isValidWholesaleQuote(incoming())
        && incoming().id == quoteId
        && (incoming().status == 'pending' || isAdmin())
        && incoming().createdAt == request.time;
      allow update: if isAdmin() && isValidId(quoteId)
        && isValidWholesaleQuote(incoming())
        && incoming().id == existing().id
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time;
      allow delete: if isAdmin() && isValidId(quoteId);
    }

    function isValidAIReviewTask(data) {
      return data.keys().hasAll([
          'id', 'actionType', 'title', 'targetType', 'targetId', 'status', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'actionType', 'title', 'titleBn', 'summary', 'summaryBn', 'targetType', 'targetId',
          'payload', 'priority', 'confidence', 'reasoning', 'reasoningBn', 'status', 'createdAt',
          'executedAt', 'executionResult', 'updatedAt'
        ])
        && isValidId(data.id)
        && data.actionType is string && data.actionType.size() >= 1 && data.actionType.size() <= 60
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 200
        && data.targetType is string && data.targetType.size() >= 1 && data.targetType.size() <= 40
        && data.targetId is string && data.targetId.size() >= 1 && data.targetId.size() <= 120
        && data.status in ['pending_review', 'executed', 'dismissed', 'failed']
        && data.createdAt is string && data.createdAt.size() <= 64
        && (!data.keys().hasAny(['payload']) || data.payload is map)
        && (!data.keys().hasAny(['priority']) || data.priority in ['high', 'medium', 'low'])
        && (!data.keys().hasAny(['confidence']) || data.confidence is number)
        && data.updatedAt is timestamp;
    }

    match /ai_review_queue/{taskId} {
      allow get: if isAdmin() && isValidId(taskId);
      allow list: if isAdmin();
      allow create: if isAdmin()
        && isValidId(taskId)
        && isValidAIReviewTask(incoming())
        && incoming().id == taskId
        && incoming().updatedAt == request.time;
      allow update: if isAdmin()
        && isValidId(taskId)
        && isValidAIReviewTask(incoming())
        && incoming().id == existing().id
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time;
      allow delete: if isAdmin() && isValidId(taskId);
    }
  }
}
